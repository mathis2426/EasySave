<Page x:Class="WPFApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFApp"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid Background="White">
        <Button x:Name="CreateJob" Content="{Binding CreateJob}" HorizontalAlignment="Left" Margin="591,95,0,0" VerticalAlignment="Top" Click="ButtonCreateJob_Click" Height="33" Width="133"/>
        <Button x:Name="DeleteJob" Command="{Binding DeleteJobCommand}" Content="{Binding DeleteJobName}" HorizontalAlignment="Left" Margin="591,160,0,0" VerticalAlignment="Top" Height="32" Width="133"/>
        <Button x:Name="Exit" Content="{Binding Exit}" HorizontalAlignment="Left" Margin="619,356,0,0" VerticalAlignment="Top" Height="32" Width="133" Click="ButtonLeave_Click"/>
        <Button x:Name="ManageJob" Content="{Binding ManageJobName}" Command="{Binding ManageJobCommand}" HorizontalAlignment="Left" Margin="591,225,0,0" VerticalAlignment="Top" Click="ButtonManageJob_Click" Height="33" Width="133"/>
        <Button x:Name="ManageAllJob" Content="{Binding ManageAllJobName}"  HorizontalAlignment="Left" Margin="591,286,0,0" VerticalAlignment="Top" Click="ButtonManageAllJob_Click" Height="33" Width="133"/>
        <ListView x:Name="TaskList" ItemsSource="{Binding JobsList}" SelectedItem="{Binding SelectedJob}" Margin="50,51,0,0" Width="500" Height="250" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{Binding ID}" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="{Binding Name}" Width="100" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{Binding SourcePath}" Width="105" DisplayMemberBinding="{Binding SourcePath}"/>
                    <GridViewColumn Header="{Binding TargetPath}" Width="105" DisplayMemberBinding="{Binding TargetPath}"/>
                    <GridViewColumn Header="{Binding Type}" Width="100" DisplayMemberBinding="{Binding Type}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox Text="{Binding OutputText}" IsReadOnly="True" Margin="50,335,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Width="517" Height="53"/>

        <!-- Language -->
        <Label Content="{Binding Language}" HorizontalAlignment="Left" Margin="527,18,0,0" VerticalAlignment="Top"/>
        <ComboBox  ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="591,20,0,0" VerticalAlignment="Top" Width="120"/>

        <Button Margin="0,17,19,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ButtonSettings_Click">
            <fa:ImageAwesome Icon="Cog" Width="27" Height="24"/>
        </Button>
        
    </Grid>
</Page>
